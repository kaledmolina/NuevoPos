// Droguería POS - Sistema de punto de venta para droguería
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuarios del sistema con rol y PIN hasheado (login server-side)
model User {
  id               String   @id @default(cuid())
  name             String   @unique
  email            String?  @unique
  role             String   // superadmin | admin | vendedor
  pinHash          String   // HMAC del PIN con AUTH_SECRET
  isPrimary        Boolean  @default(false) // Admin principal inmutable
  allowedBranchIds String   @default("[]")  // IDs de sedes permitidas en formato JSON string
  tenantId         String?  // Relación con su Tenant / Negocio (null para Superadmin global)
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// Log de auditoría: registra quién hizo qué y cuándo
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // login, logout, sale_create, sale_annul, product_create, product_update, product_delete, purchase_create, purchase_annul, cash_open, cash_close, cash_tx, transaction_create, transaction_update, transaction_delete, category_create, category_update, category_delete, seed
  entityType String  // sale, product, purchase, cash, transaction, category, user, system
  entityId  String?
  userName  String
  role      String
  detail    String?  // descripción legible
  meta      String?  // JSON string con detalles adicionales
  createdAt DateTime @default(now())
}

// Catálogos
model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  products  Product[]
}

model Product {
  id             String         @id @default(cuid())
  name           String
  sku            String?        // código interno
  barcode        String?        // código de barras
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  branchId       String?        // Sede a la que pertenece el producto
  description    String?
  image          String?        // URL o imagen del producto
  cost           Float          @default(0) // último precio de compra
  price          Float          @default(0) // precio de venta
  stock          Int            @default(0) // stock total (suma de lotes)
  minStock       Int            @default(5) // alerta de reposición
  unit           String         @default("unidad")
  expirationDate DateTime?      // fecha de vencimiento (del lote más próximo, legacy)
  batch          String?        // lote (legacy)
  location       String?        // ubicación en estante
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  batches        ProductBatch[]

  @@index([branchId])
  @@index([active])
}

// Lotes individuales por producto (para gestionar múltiples vencimientos)
model ProductBatch {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          String?  // identificador del lote
  stock          Int      @default(0) // unidades disponibles en este lote
  cost           Float    @default(0) // costo de compra de este lote
  expirationDate DateTime? // vencimiento de este lote
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Terceros
model Client {
  id        String   @id @default(cuid())
  name      String
  document  String?  // cédula / NIT
  phone     String?
  email     String?
  address   String?
  notes     String?
  branchId  String?  // Sede a la que pertenece el cliente
  isGeneric Boolean  @default(false) // marca el cliente genérico (no puede comprar a crédito)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  creditAccount CreditAccount?

  @@index([branchId])
}

// Cuenta de crédito por cliente (cuentas por cobrar)
model CreditAccount {
  id          String   @id @default(cuid())
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creditLimit Float    @default(0) // límite máximo que el admin otorga
  balance     Float    @default(0) // saldo actual que debe el cliente (positivo = debe)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  movements   CreditMovement[]
}

// Movimientos de crédito: ventas a crédito y abonos
model CreditMovement {
  id               String   @id @default(cuid())
  accountId        String
  account          CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             String   // "cargo" (venta a crédito) | "abono" (pago del cliente)
  amount           Float
  concept          String
  method           String?  @default("efectivo") // efectivo, credito
  reportedBy       String?  // Nombre del usuario/cajero que reportó el movimiento/abono
  previousBalance  Float?   // Saldo antes del movimiento
  remainingBalance Float?   // Saldo pendiente tras el movimiento
  saleId           String?  // referencia a la venta si es un cargo
  createdAt        DateTime @default(now())
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  document    String?   // NIT
  phone       String?
  email       String?
  address     String?
  contactName String?
  notes       String?
  branchId    String?   // Sede a la que pertenece el proveedor
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  purchases   Purchase[]
}

// Ventas
model Sale {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  branchId      String?    // Sede en la que se realizó la venta
  subtotal      Float
  tax           Float      @default(0)
  discount      Float      @default(0)
  total         Float
  paymentMethod String     @default("efectivo") // efectivo, tarjeta, transferencia, credito
  amountReceived Float     @default(0)
  change        Float      @default(0)
  status        String     @default("completada") // completada, anulada
  cashSessionId String?
  notes         String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  unitCost  Float
  subtotal  Float
}

// Compras a proveedores
model Purchase {
  id         String          @id @default(cuid())
  reference  String?         // factura del proveedor
  supplierId String?
  supplier   Supplier?       @relation(fields: [supplierId], references: [id])
  branchId   String?         // Sede donde se recibió la compra
  subtotal   Float
  tax        Float           @default(0)
  total      Float
  status     String          @default("recibida") // recibida, pendiente, anulada
  notes      String?
  createdAt  DateTime        @default(now())
  items      PurchaseItem[]

  @@index([branchId])
}

model PurchaseItem {
  id             String   @id @default(cuid())
  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  quantity       Int
  unitCost       Float
  subtotal       Float
  expirationDate DateTime?
  batch          String?
}

// Caja y arqueo
model CashSession {
  id            String           @id @default(cuid())
  branchId      String?          // Sede a la que pertenece la sesión de caja
  openingAmount Float
  closingAmount Float?
  expectedAmount Float?
  difference    Float?
  status        String           @default("abierta") // abierta, cerrada
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  openedBy      String?
  closedBy      String?
  notes         String?
  transactions  CashTransaction[]

  @@index([branchId])
}

model CashTransaction {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          String      // ingreso, egreso, venta
  amount        Float
  concept       String
  method        String      @default("efectivo")
  reference     String?
  createdAt     DateTime    @default(now())
}

// Ingresos y egresos generales
model Transaction {
  id            String   @id @default(cuid())
  branchId      String?  // Sede a la que pertenece la transacción
  type          String   // ingreso, egreso
  category      String
  amount        Float
  concept       String
  description   String?
  method        String   @default("efectivo")
  date          DateTime @default(now())
  cashSessionId String?
  createdAt     DateTime @default(now())
}

// Configuración de la tienda
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Multi-Sedes (sucursales físicas, máx 3 sedes por negocio)
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String?
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  active    Boolean  @default(true)
  tenantId  String?  // Negocio / Empresa al que pertenece la sede
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// SaaS Multi-Tenancy: Empresas / Negocios registrados
model Tenant {
  id          String    @id @default(cuid())
  name        String    // Nombre del negocio / droguería
  slug        String?   @unique
  rubro       String    @default("drogueria")
  ownerName   String    // Nombre del Administrador Principal
  ownerEmail  String    @unique // Correo del Administrador Principal
  ownerPhone  String?
  status      String    @default("pendiente") // "pendiente" | "aprobado" | "inactivo"
  maxBranches Int       @default(3)
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  branches    Branch[]

  @@index([status])
  @@index([rubro])
}

