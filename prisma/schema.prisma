// OmniPOS - Sistema de punto de venta y CRM Omnicanal para Droguerías y Comercios
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Usuarios del sistema con rol y PIN hasheado (login server-side)
model User {
  id               String   @id @default(cuid())
  name             String   @unique
  email            String?  @unique
  role             String   // superadmin | admin | vendedor
  pinHash          String   // HMAC del PIN con AUTH_SECRET
  isPrimary        Boolean  @default(false) // Admin principal inmutable
  allowedBranchIds String   @default("[]") @db.Text // IDs de sedes permitidas en formato JSON string
  tenantId         String?  // Relación con su Tenant / Negocio (null para Superadmin global)
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

// Log de auditoría: registra quién hizo qué y cuándo
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // login, logout, sale_create, sale_annul, product_create...
  entityType String   // sale, product, purchase, cash, transaction, category, user, system
  entityId   String?
  userName   String
  role       String
  detail     String?  @db.Text // descripción legible sin límite
  meta       String?  @db.Text // JSON string con detalles adicionales
  createdAt  DateTime @default(now())
}

// Catálogos
model Category {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id             String         @id @default(cuid())
  name           String
  sku            String?        // código interno
  barcode        String?        // código de barras
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  branchId       String?        // Sede a la que pertenece el producto
  description    String?        @db.Text
  image          String?        @db.Text // URL o imagen del producto
  cost           Float          @default(0) // último precio de compra
  price          Float          @default(0) // precio de venta
  stock          Int            @default(0) // stock total (suma de lotes)
  minStock       Int            @default(5) // alerta de reposición
  unit           String         @default("unidad")
  expirationDate DateTime?      // fecha de vencimiento (del lote más próximo, legacy)
  batch          String?        // lote (legacy)
  location       String?        // ubicación en estante
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  batches        ProductBatch[]
  orderItems     OrderItem[]

  @@index([branchId])
  @@index([active])
}

// Lotes individuales por producto (para gestionar múltiples vencimientos)
model ProductBatch {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          String?   // identificador del lote
  stock          Int       @default(0) // unidades disponibles en este lote
  cost           Float     @default(0) // costo de compra de este lote
  expirationDate DateTime? // vencimiento de este lote
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Terceros
model Client {
  id               String            @id @default(cuid())
  name             String
  document         String?           // cédula / NIT
  phone            String?
  email            String?
  address          String?           @db.Text
  notes            String?           @db.Text
  branchId         String?           // Sede a la que pertenece el cliente
  isGeneric        Boolean           @default(false) // marca el cliente genérico (no puede comprar a crédito)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sales            Sale[]
  orders           Order[]
  whatsappMessages WhatsAppMessage[]
  creditAccount    CreditAccount?

  @@index([branchId])
}

// Cuenta de crédito por cliente (cuentas por cobrar)
model CreditAccount {
  id          String           @id @default(cuid())
  clientId    String           @unique
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creditLimit Float            @default(0) // límite máximo que el admin otorga
  balance     Float            @default(0) // saldo actual que debe el cliente (positivo = debe)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movements   CreditMovement[]
}

// Movimientos de crédito: ventas a crédito y abonos
model CreditMovement {
  id               String        @id @default(cuid())
  accountId        String
  account          CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             String        // "cargo" (venta a crédito) | "abono" (pago del cliente)
  amount           Float
  concept          String
  method           String?       @default("efectivo") // efectivo, credito
  reportedBy       String?       // Nombre del usuario/cajero que reportó el movimiento/abono
  previousBalance  Float?        // Saldo antes del movimiento
  remainingBalance Float?        // Saldo pendiente tras el movimiento
  saleId           String?       // referencia a la venta si es un cargo
  createdAt        DateTime      @default(now())
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  document    String?    // NIT
  phone       String?
  email       String?
  address     String?    @db.Text
  contactName String?
  notes       String?    @db.Text
  branchId    String?    // Sede a la que pertenece el proveedor
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

// Ventas
model Sale {
  id             String     @id @default(cuid())
  invoiceNumber  String     @unique
  clientId       String?
  client         Client?    @relation(fields: [clientId], references: [id])
  branchId       String?    // Sede en la que se realizó la venta
  subtotal       Float
  tax            Float      @default(0)
  discount       Float      @default(0)
  total          Float
  paymentMethod  String     @default("efectivo") // efectivo, tarjeta, transferencia, credito
  amountReceived Float      @default(0)
  change         Float      @default(0)
  status         String     @default("completada") // completada, anulada
  cashSessionId  String?
  notes          String?    @db.Text
  createdAt      DateTime   @default(now())
  items          SaleItem[]

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  unitCost  Float
  subtotal  Float
}

// Compras a proveedores
model Purchase {
  id         String         @id @default(cuid())
  reference  String?        // factura del proveedor
  supplierId String?
  supplier   Supplier?      @relation(fields: [supplierId], references: [id])
  branchId   String?        // Sede donde se recibió la compra
  subtotal   Float
  tax        Float          @default(0)
  total      Float
  status     String         @default("recibida") // recibida, pendiente, anulada
  notes      String?        @db.Text
  createdAt  DateTime       @default(now())
  items      PurchaseItem[]

  @@index([branchId])
}

model PurchaseItem {
  id             String    @id @default(cuid())
  purchaseId     String
  purchase       Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantity       Int
  unitCost       Float
  subtotal       Float
  expirationDate DateTime?
  batch          String?
}

// Caja y arqueo
model CashSession {
  id             String            @id @default(cuid())
  branchId       String?           // Sede a la que pertenece la sesión de caja
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?
  difference     Float?
  status         String            @default("abierta") // abierta, cerrada
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openedBy       String?
  closedBy       String?
  notes          String?           @db.Text
  transactions   CashTransaction[]

  @@index([branchId])
}

model CashTransaction {
  id            String      @id @default(cuid())
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          String      // ingreso, egreso, venta
  amount        Float
  concept       String
  method        String      @default("efectivo")
  reference     String?
  createdAt     DateTime    @default(now())
}

// Ingresos y egresos generales
model Transaction {
  id            String   @id @default(cuid())
  branchId      String?  // Sede a la que pertenece la transacción
  type          String   // ingreso, egreso
  category      String
  amount        Float
  concept       String
  description   String?  @db.Text
  method        String   @default("efectivo")
  date          DateTime @default(now())
  cashSessionId String?
  createdAt     DateTime @default(now())
}

// Configuración de la tienda
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// Multi-Sedes (sucursales físicas, máx 3 sedes por negocio)
model Branch {
  id               String            @id @default(cuid())
  name             String
  code             String?
  address          String?           @db.Text
  phone            String?
  isMain           Boolean           @default(false)
  active           Boolean           @default(true)
  tenantId         String?           // Negocio / Empresa al que pertenece la sede
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orders           Order[]
  whatsappMessages WhatsAppMessage[]
  whatsappConfig   WhatsAppConfig?

  @@index([tenantId])
}

// SaaS Multi-Tenancy: Empresas / Negocios registrados
model Tenant {
  id          String    @id @default(cuid())
  name        String    // Nombre del negocio / droguería
  slug        String?   @unique
  rubro       String    @default("drogueria")
  ownerName   String    // Nombre del Administrador Principal
  ownerEmail  String    @unique // Correo del Administrador Principal
  ownerPhone  String?
  status      String    @default("pendiente") // "pendiente" | "aprobado" | "inactivo"
  maxBranches Int       @default(3)
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users       User[]
  branches    Branch[]
  orders      Order[]

  @@index([status])
  @@index([rubro])
}

// Pedidos externos y de clientes / marketplace / domicilios
model Order {
  id                  String            @id @default(cuid())
  orderNumber         String            @unique
  tenantId            String?
  tenant              Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  clientId            String?
  client              Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customerName        String
  customerPhone       String
  customerEmail       String?
  deliveryAddress     String?           @db.Text
  deliveryNotes       String?           @db.Text
  subtotal            Float             @default(0)
  tax                 Float             @default(0)
  deliveryFee         Float             @default(0)
  discount            Float             @default(0)
  total               Float             @default(0)
  paymentMethod       String            @default("contraentrega")
  paymentStatus       String            @default("pendiente")
  status              String            @default("pendiente")
  notes               String?           @db.Text
  createdByRole       String            @default("cliente")
  createdById         String?
  deliveryDriverId    String?
  deliveryDriverName  String?
  deliveryDriverPhone String?
  assignedAt          DateTime?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               OrderItem[]
  whatsappMessages    WhatsAppMessage[]

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([deliveryDriverId])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  quantity    Int
  unitPrice   Float
  subtotal    Float
  notes       String? @db.Text

  @@index([orderId])
  @@index([productId])
}

// Historial de Mensajería WhatsApp & CRM Omnicanal
model WhatsAppMessage {
  id        String   @id @default(cuid())
  phone     String
  channel   String   @default("whatsapp") // "whatsapp" | "telegram"
  sender    String   // "customer" | "bot" | "agent"
  text      String   @db.Text
  status    String   @default("read") // "unread" | "read" | "sent" | "delivered"
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([channel])
  @@index([branchId])
  @@index([createdAt])
}

// Plantillas de Difusión y Promociones WhatsApp
model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   // "promocion", "cobro", "recordatorio", "novedad"
  content   String   @db.Text
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Configuración de Canales (WhatsApp & Telegram) e IA por Sede
model WhatsAppConfig {
  id                  String   @id @default(cuid())
  branchId            String   @unique
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  phoneNumber         String?  // Ej. +573001234567
  metaPhoneNumberId   String?  // ID de número en Meta Cloud API
  metaAccessToken     String?  @db.Text // Token de acceso de Meta Cloud API (largo, 300+ chars)
  metaVerifyToken     String?  @default("omnipos_verify_token_2026")
  telegramBotToken    String?  @db.Text // Token del bot de Telegram (@BotFather)
  telegramBotUsername String?  // Username del bot (ej. @mi_tienda_bot)
  telegramEnabled     Boolean  @default(false)
  aiProvider          String   @default("deepseek") // "deepseek" | "openrouter"
  deepseekApiKey      String?  @db.Text // Token de API de DeepSeek
  deepseekModel       String   @default("deepseek-chat") // "deepseek-chat" | "deepseek-reasoner"
  openrouterApiKey    String?  @db.Text // Token de API de OpenRouter
  openrouterModel     String   @default("deepseek/deepseek-chat")
  aiEnabled           Boolean  @default(true)
  aiSystemPrompt      String?  @db.Text
  welcomeMessage      String?  @db.Text
  autoCreateOrders    Boolean  @default(true)
  maxTokensPerReply   Int      @default(300)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([branchId])
}
